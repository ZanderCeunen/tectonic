# TECTONIC Environment Configuration Template
# Copy this file to backend/.env or export in shell

# REQUIRED: Cryptographically secure secret key for HS256 JWT tokens (minimum 32 bytes)
JWT_SECRET=SDWorx_Tectonic_Production_Secret_Key_At_Least_32_Bytes_Long_2026!

# OPTIONAL: Seed passwords for initial test accounts.
# If TECTONIC_ADMIN_PASSWORD is not set, default user accounts will NOT be created automatically.
