# TECTONIC Environment Configuration Template
# Kopieer naar .env / backend/.env (backend laadt .env vanaf zijn werkdirectory)

# REQUIRED: Cryptographically secure secret key voor HS256 JWT tokens (min 32 bytes)
JWT_SECRET=SDWorx_Tectonic_Production_Secret_Key_At_Least_32_Bytes_Long_2026!

# OPTIONAL: Seed passwords voor testaccounts
TECTONIC_ADMIN_PASSWORD=Admin123!
TECTONIC_CONSULTANT_PASSWORD=Payroll123!

# ALLOWED CORS ORIGINS (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

# --- Microsoft Entra ID / Microsoft 365 login (OAuth2 Authorization Code Flow) ---
# Zonder deze drie waarden draait de Microsoft login in demomodus.
TENANT_ID=
CLIENT_ID=
CLIENT_SECRET=
# Optioneel:
# REDIRECT_URI=http://127.0.0.1:8080/api/auth/microsoft/callback
# FRONTEND_URL=http://localhost:3000
# MS_ADMIN_GROUP_ID=<entra-group-object-id>
# MS_ROLE_GROUPS=<group-id>:Admin;<group-id>:Senior Payroll Officer
